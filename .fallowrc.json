{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": ["babel-plugin-react-compiler"],
  "ignoreDependencyOverrides": [
    {
      "package": "vite",
      "source": "pnpm-workspace.yaml"
    },
    {
      "package": "vitest",
      "source": "pnpm-workspace.yaml"
    }
  ],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "resolve": {
    "conditions": ["edge-light"]
  },
  "includeEntryExports": true,
  "publicPackages": ["@website/ui"],
  "rules": {
    "boundary-violation": "error"
  },
  "boundaries": {
    "preset": "bulletproof",
    "zones": [
      {
        "name": "app",
        "patterns": ["apps/web/src/app/**"]
      },
      {
        "name": "features",
        "patterns": ["apps/web/src/features/**"],
        "autoDiscover": ["apps/web/src/features"]
      },
      {
        "name": "shared",
        "patterns": [
          "apps/web/src/assets/**",
          "apps/web/src/components/**",
          "apps/web/src/config/**",
          "apps/web/src/hooks/**",
          "apps/web/src/lib/**",
          "apps/web/src/providers/**",
          "apps/web/src/shared/**",
          "apps/web/src/stores/**",
          "apps/web/src/styles/**",
          "apps/web/src/testing/**",
          "apps/web/src/types/**",
          "apps/web/src/utils/**",
          "apps/web/src/*.css",
          "packages/env/src/**",
          "packages/ui/src/**"
        ]
      },
      {
        "name": "server",
        "patterns": ["apps/web/src/server/**"]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "*.config.ts",
        "*.setup.ts",
        "apps/*/*.config.ts",
        "packages/*/*.config.ts"
      ]
    }
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["packages/ui/src/components/**"],
        "maxCrap": 420,
        "reason": "Vendored shadcn/ui components, regenerated by `shadcn add`, so local refactors are overwritten upstream. CRAP is the sole trigger for every finding here and is uninformative: the repo ships no tests, so coverage is static-estimated at 0 and CRAP collapses to cyclomatic^2 + cyclomatic. 420 is that value at the repo's cyclomatic ceiling of 20, which retires the redundant CRAP signal while leaving maxCyclomatic (20), maxCognitive (15) and maxUnitSize (60) fully enforced on these files. Lower or remove this once real coverage data is wired into `health.coverage`."
      }
    ]
  }
}

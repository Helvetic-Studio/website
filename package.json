{
  "name": "website",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "prepare": "vp config",
    "typegen": "vp run -r typegen",
    "check-types": "vp run -r check-types",
    "lint": "vp run typegen && vp lint",
    "lint:fix": "vp run typegen && vp lint --fix",
    "format": "vp fmt",
    "format:fix": "vp fmt --fix",
    "check": "vp run typegen && vp check",
    "fix": "vp run typegen && vp check --fix",
    "test": "vp test",
    "test:e2e": "vp run -r test:e2e",
    "test:e2e:install": "vp run -r test:e2e:install",
    "test:e2e:ui": "vp run -r test:e2e:ui",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "fallow": "fallow",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "@website/config": "workspace:*",
    "fallow": "3.33.1",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "rolldown": "1.2.14",
    "typescript": "catalog:",
    "ultracite": "7.10.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0"
}

{
  "name": "website",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:fix": "vp fmt --fix",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "fallow": "fallow",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@website/config": "workspace:*",
    "fallow": "^3.14.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.0",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vite-plus": "0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
